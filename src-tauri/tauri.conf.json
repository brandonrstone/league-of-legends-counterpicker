{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "League of Legends Counterpicker",
  "version": "1.0.4",
  "identifier": "com.counterpicker.lol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "League of Legends Counterpicker",
        "width": 440,
        "height": 820,
        "minWidth": 400,
        "minHeight": 640,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "League of Legends Counterpicker",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://raw.communitydragon.org https://ddragon.leagueoflegends.com data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src ipc: http://ipc.localhost https://raw.communitydragon.org https://ddragon.leagueoflegends.com https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}